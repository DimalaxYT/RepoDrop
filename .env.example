# ------------------------------------------------------------------ OAuth GitHub
# Créez une OAuth App sur https://github.com/settings/developers
#   Homepage URL      : http://localhost:3000
#   Callback URL      : http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# URL publique de l'application (utilisée pour le callback OAuth ET pour la
# sonde de disponibilité du bot Discord : <APP_URL>/api/health)
APP_URL=http://localhost:3000

# Base de l'API GitHub. À laisser telle quelle, sauf pour tester contre un
# serveur local (c'est ce qui permet de vérifier /repos sans jeton réel).
# GITHUB_API_URL=https://api.github.com

# Secret de chiffrement des sessions (32+ octets aléatoires).
# Génération : openssl rand -hex 32
# ⚠ Obligatoire pour que le jeton Discord enregistré depuis le panel staff
#   survive à un redémarrage (il est chiffré avec une clé dérivée de ce secret).
SESSION_SECRET=

# Protection anti-clickjacking (directive CSP `frame-ancestors` + X-Frame-Options).
# Vide par défaut : l'application peut alors être affichée dans une iframe, ce
# qui est nécessaire à l'aperçu de développement. En production, mettre 'self'.
# ⚠ Lu au BUILD (next build), pas au démarrage : Next.js fige `headers()` dans
#   .next/routes-manifest.json. La poser seulement au runtime n'a aucun effet.
#   Exemple :  FRAME_ANCESTORS="'self'" npm run build
FRAME_ANCESTORS=

# Mode développement : affiche un bouton « connexion directe » qui utilise le
# jeton GH_TOKEN / GITHUB_TOKEN du serveur. NE PAS activer en production.
DEV_AUTH=1

# --------------------------------------------------------------------- Limites
MAX_UPLOAD_MB=200        # poids max de l'archive uploadée (.rar/.zip/.tar/.tar.gz)
MAX_EXTRACT_MB=500       # poids max une fois décompressée
MAX_ARCHIVE_MB=250       # poids max d'un dépôt téléchargé depuis /repos (.zip/.tar.gz)
MAX_FILES=20000          # nombre max de fichiers dans l'archive
UPLOADS_PER_HOUR=30      # rate-limit uploads par IP
PUSHES_PER_HOUR=10       # rate-limit poussées par utilisateur

# ----------------------------------------------------------------- Panel staff
# Logins GitHub autorisés sur le panel staff (/staff), séparés par des virgules.
# Vide + DEV_AUTH=1 → tout compte connecté y a accès (dev uniquement).
STAFF_LOGINS=

# Second verrou du panel : mot de passe demandé après l'allowlist.
# Optionnel — il est surtout fait pour être défini depuis le panel
# (onglet « Sécurité »), où il est haché en scrypt avant stockage.
# Cette variable ne sert qu'à l'amorçage ; la valeur du panel a priorité.
# STAFF_PASSWORD=

# -------------------------------------------------------------- Bot Discord
# Tout ceci est aussi configurable depuis le panel staff (onglet « Discord ») :
# ce qui est saisi dans le panel a priorité sur ces variables.
# DISCORD_BOT_TOKEN=          # jeton de bot (Portail développeurs → Bot)
# DISCORD_WEBHOOK_URL=        # … ou simplement une URL de webhook
# DISCORD_CHANNEL_ID=         # canal cible (inutile avec un webhook)
# DISCORD_PING_MINUTES=10     # période du ping de disponibilité

# --------------------------------------------------------------- Infra (optionnel)
# JOBS_DIR=/tmp/repodrop-jobs   # dossier de travail des extractions (éphémère)
# DB_PATH=./data/repodrop.db    # base SQLite des jobs, du journal et des réglages
